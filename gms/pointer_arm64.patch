+// findFrameChunk scans the anonymous private mappings of the process for a
+// glibc malloc chunk served by mmap that is large enough to hold one frame
+// and whose content looks like an opaque BGRA image (alpha byte == 0xff).
+// Such a chunk starts with a 16-byte header: prev_size (8 bytes, zero for
+// mmapped chunks) and size|flags (8 bytes, flag 0x2 = IS_MMAPPED). Several
+// mmapped chunks may share one mapping, so the whole mapping is scanned.
+// The returned address is the chunk start, matching the semantics of the
+// walk-based detection (the first 16 bytes read are the header).
+func findFrameChunk(pid string) (int64, error) {
+	maps, err := os.Open(fmt.Sprintf("/proc/%s/maps", pid))
+	if err != nil {
+		return 0, err
+	}
+	defer maps.Close()
+	mem, err := os.Open(fmt.Sprintf("/proc/%s/mem", pid))
+	if err != nil {
+		return 0, err
+	}
+	defer mem.Close()
+
+	const maxSlack = 4 << 20 // chunk may be a bit bigger than the frame (alignment, padding)
+	scanner := bufio.NewScanner(maps)
+	for scanner.Scan() {
+		fields := strings.Fields(scanner.Text())
+		if len(fields) != 5 || fields[1] != "rw-p" {
+			continue // only anonymous (unnamed) private writable mappings
+		}
+		startEnd := strings.Split(fields[0], "-")
+		if len(startEnd) != 2 {
+			continue
+		}
+		start, err1 := strconv.ParseInt(startEnd[0], 16, 64)
+		end, err2 := strconv.ParseInt(startEnd[1], 16, 64)
+		if err1 != nil || err2 != nil {
+			continue
+		}
+		size := end - start
+		if size < ScreenSizeBytes+16 {
+			continue
+		}
+		region := make([]byte, size)
+		n, err := mem.ReadAt(region, start)
+		if err != nil && n < ScreenSizeBytes+16 {
+			continue
+		}
+		region = region[:n]
+		for off := int64(0); off+16 <= int64(len(region)); off += 16 {
+			if binary.LittleEndian.Uint64(region[off:off+8]) != 0 {
+				continue // prev_size must be zero for an mmapped chunk
+			}
+			chunkSize := int64(binary.LittleEndian.Uint64(region[off+8:off+16])) &^ 7
+			if chunkSize < ScreenSizeBytes || chunkSize > ScreenSizeBytes+maxSlack || off+16+ScreenSizeBytes > int64(len(region)) {
+				continue
+			}
+			if looksLikeOpaqueBGRA(region[off+16 : off+16+ScreenSizeBytes]) {
+				return start + off, nil
+			}
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return 0, err
+	}
+	return 0, fmt.Errorf("no mmapped malloc chunk holding an opaque BGRA frame found")
+}
+
+// looksLikeOpaqueBGRA samples pixels across the buffer and requires the alpha
+// byte to be 0xff in (almost) all of them. Other large buffers of the same
+// size exist in xochitl (e.g. display-controller staging buffers) but they do
+// not have a constant opaque alpha channel.
+func looksLikeOpaqueBGRA(buf []byte) bool {
+	const samples = 4096
+	step := (len(buf) / 4 / samples) * 4
+	if step < 4 {
+		step = 4
+	}
+	opaque, total := 0, 0
+	for i := 3; i < len(buf); i += step {
+		total++
+		if buf[i] == 0xff {
+			opaque++
+		}
+	}
+	return total > 0 && opaque*100 >= total*99
+}
