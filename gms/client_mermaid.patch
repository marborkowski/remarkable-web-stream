+    // ---------------------------------------------------------------------
+    // Drawing jobs
+    // ---------------------------------------------------------------------
+
+    async function runJob(body, onProgress, signal) {
+        const res = await fetch('/draw', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(body),
+            signal
+        });
+        if (!res.ok) throw new Error((await res.text()).trim() || 'HTTP ' + res.status);
+        const reader = res.body.getReader();
+        const decoder = new TextDecoder();
+        let buf = '';
+        for (;;) {
+            const { value, done } = await reader.read();
+            if (done) throw new Error('the connection to the tablet was lost');
+            buf += decoder.decode(value, { stream: true });
+            let nl;
+            while ((nl = buf.indexOf('\n')) >= 0) {
+                const msg = JSON.parse(buf.slice(0, nl));
+                buf = buf.slice(nl + 1);
+                if (msg.error) throw new Error(msg.error);
+                if (msg.ok) return;
+                onProgress(msg);
+            }
+        }
+    }
+
+    const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+    async function drawOnTablet() {
+        if (!plan || job) return;
+        if (typeof deviceOrientation === 'string' && deviceOrientation !== 'Portrait') {
+            setStatus('Turn the tablet to portrait first: the text grid is measured in portrait.', true);
+            return;
+        }
+        if (typeof drawMode !== 'undefined' && drawMode) setDrawMode(false);
+        job = new AbortController();
+        const signal = job.signal;
+        updateButtons();
+        try {
+            let { strokes } = plan;
+            if (plan.text) {
+                setStatus('Taking a screenshot…');
+                const before = await grabScreen();
+                await runJob({ text: plan.text }, p => setStatus(`Typing the labels… ${p.done}/${p.total} keys`), signal);
+                await sleep(1500);
+                setStatus('Looking for the labels on the screen…');
+                const after = await grabScreen();
+                const found = locateText(before, after, plan.rows);
+                if (!found) {
+                    throw new Error('The typed labels were not found on the screen, so nothing was drawn. ' +
+                        'Use an empty page in portrait, not zoomed, with the default text width. Undo the text on the tablet and try again.');
+                }
+                strokes = strokes.map(line => line.map(p => ({ x: p.x + found.dx, y: p.y + found.dy })));
+                const [, bottom] = extent(strokes, p => p.y);
+                if (bottom > screenHeight - PAGE_MARGIN.bottom) {
+                    throw new Error('The labels landed too low on the page for the diagram to fit, so nothing was drawn. Use an empty page.');
+                }
+            }
+            const norm = strokes.map(line => line.flatMap(p => [
+                +((p.x - PEN_MAP.ox) / PEN_MAP.sx / screenWidth).toFixed(5),
+                +((p.y - PEN_MAP.oy) / PEN_MAP.sy / screenHeight).toFixed(5)
+            ]));
+            await runJob({ strokes: norm }, p => setStatus(`Drawing… ${Math.round(100 * p.done / p.total)}%`), signal);
+            setStatus('Done.');
+            showMessage('Diagram drawn on the tablet', MessageDuration.QUICK);
+        } catch (e) {
+            setStatus(signal.aborted ? 'Stopped.' : e.message, !signal.aborted);
+        } finally {
+            job = null;
+            updateButtons();
+        }
+    }
