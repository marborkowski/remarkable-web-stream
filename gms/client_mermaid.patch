+    // ---------------------------------------------------------------------
+    // Layout on the lines of the tablet's text
+    // ---------------------------------------------------------------------
+
+    function fail(message) {
+        const e = new Error(message);
+        e.layout = true;
+        throw e;
+    }
+
+    function layout(diagram) {
+        const P = TEXT.linePitch;
+        const space = measure(' ');
+        const warnings = diagram.warnings.slice();
+        const labels = diagram.labels
+            .map(l => Object.assign({}, l, { text: sanitize(l.text) }))
+            .filter(l => l.text);
+        if (diagram.labels.some(l => sanitize(l.text) !== l.text.replace(/\s+/g, ' ').trim())) {
+            warnings.push('Characters the tablet keyboard cannot type were replaced (e.g. ą → a, [ → ().');
+        }
+        for (const l of labels) l.width = measure(l.text);
+        if (!diagram.strokes.length && !labels.length) fail('The diagram is empty.');
+
+        // Labels whose baselines are close share a text line, unless they overlap.
+        labels.sort((a, b) => a.baseline - b.baseline || a.x - b.x);
+        const rows = [];
+        for (const l of labels) {
+            const row = rows[rows.length - 1];
+            const clash = row && row.labels.some(o => l.x < o.x + o.width + space && o.x < l.x + l.width + space);
+            if (row && l.baseline - row.first <= ROW_TOLERANCE && !clash) {
+                row.labels.push(l);
+            } else {
+                rows.push({ first: l.baseline, labels: [l] });
+            }
+        }
+        let index = 0;
+        rows.forEach((row, i) => {
+            row.y = row.labels.reduce((s, l) => s + l.baseline, 0) / row.labels.length;
+            if (i > 0) {
+                row.y = Math.max(row.y, rows[i - 1].y + 0.5);
+                // Squeezing rows together more than this pushes lines that
+                // run between them (box edges, dividers) into the text.
+                const gap = row.y - rows[i - 1].y;
+                let n = Math.max(1, Math.round(gap / P));
+                if (n * P < gap * 0.85) n++;
+                index += n;
+            }
+            row.index = index;
+        });
+
+        // Horizontally: labels centred in the text column, strokes on the page.
+        const [minX, maxX] = extent(diagram.strokes, p => p.x);
+        let tx;
+        if (labels.length) {
+            const [left] = extent([labels], l => l.x);
+            const [, right] = extent([labels], l => l.x + l.width);
+            if (right - left > TEXT.columnWidth - 2 * space) {
+                fail(`The diagram is too wide for the tablet's text: its labels span ${Math.round(right - left)} px, a line holds ${TEXT.columnWidth} px. Try "flowchart TD" or shorter labels.`);
+            }
+            tx = TEXT.left + (TEXT.columnWidth - (right - left)) / 2 - left;
+            if (minX + tx < PAGE_MARGIN.left) {
+                tx = PAGE_MARGIN.left - minX;
+            } else if (maxX + tx > screenWidth - PAGE_MARGIN.right) {
+                tx = screenWidth - PAGE_MARGIN.right - maxX;
+            }
+            if (left + tx < TEXT.left - 0.5 || right + tx > TEXT.left + TEXT.columnWidth) {
+                fail('The diagram does not fit on the page next to the toolbar. Try "flowchart TD" or shorter labels.');
+            }
+        } else {
+            tx = (screenWidth - maxX - minX) / 2;
+        }
+
+        // Vertically: a piecewise-linear stretch that puts every label row on
+        // its text line; above the first and below the last row it only
+        // shifts. offset is the number of empty text lines before the first
+        // row, which keep the diagram clear of the top of the page.
+        const warpWith = offset => {
+            const anchors = rows.map(r => [r.y, TEXT.firstBaseline + (r.index + 1 + offset) * P]);
+            if (!anchors.length) anchors.push([extent(diagram.strokes, p => p.y)[0], PAGE_MARGIN.top + 40]);
+            return y => {
+                let k = 0;
+                while (k < anchors.length - 1 && y > anchors[k + 1][0]) k++;
+                const [s0, d0] = anchors[k];
+                if (y <= s0 || k === anchors.length - 1) return y - s0 + d0;
+                const [s1, d1] = anchors[k + 1];
+                return d0 + (y - s0) * (d1 - d0) / (s1 - s0);
+            };
+        };
+        let offset = 0;
+        let warp = warpWith(0);
+        const [top] = extent(diagram.strokes, p => warp(p.y));
+        if (rows.length && top < PAGE_MARGIN.top) {
+            offset = Math.ceil((PAGE_MARGIN.top - top) / P);
+            warp = warpWith(offset);
+        }
+
+        // The text, typed as a new paragraph: an empty line (so that a label
+        // like "- x" cannot start a list), then one line per row with the
+        // labels moved right with spaces.
+        const lines = [];
+        const boxes = []; // where the typed labels will be: strokes stay out
+        const last = rows.length ? rows[rows.length - 1].index : -1;
+        for (let i = 0; i < offset; i++) lines.push('');
+        for (let i = 0; i <= last; i++) {
+            const row = rows.find(r => r.index === i);
+            const baseline = TEXT.firstBaseline + (lines.length + 1) * P;
+            let line = '';
+            for (const l of row ? row.labels.sort((a, b) => a.x - b.x) : []) {
+                const target = l.x + tx;
+                let n = Math.round((target - TEXT.left - measure(line)) / space);
+                if (line && n < 1) {
+                    n = 1;
+                    warnings.push(`"${l.text}" is moved right: it is too close to the label before it.`);
+                }
+                line += ' '.repeat(Math.max(0, n));
+                const x = TEXT.left + measure(line);
+                const ink = measureCtx.measureText(l.text);
+                boxes.push({
+                    x0: x - ink.actualBoundingBoxLeft - 3, x1: x + ink.actualBoundingBoxRight + 3,
+                    y0: baseline - ink.actualBoundingBoxAscent - 3, y1: baseline + ink.actualBoundingBoxDescent + 3
+                });
+                line += l.text;
+            }
+            if (measure(line) > TEXT.columnWidth) {
+                fail('A line of labels is too wide for the tablet\'s text. Try "flowchart TD" or shorter labels.');
+            }
+            lines.push(line);
+        }
+
+        // The strokes, minus their parts under labels (Mermaid hides the
+        // lines behind edge labels with a background).
+        let strokes = diagram.strokes.map(line => line.map(p => ({ x: p.x + tx, y: warp(p.y) })));
+        for (const box of boxes) {
+            strokes = strokes.flatMap(line => clip(line, box, true));
+        }
+        strokes = strokes
+            .flatMap(line => penStrokes(simplify(line, 0.35)))
+            .filter(line => line.length > 1 && length(line) >= 3); // drop specks left by the cuts
+        const [, bottom] = extent(strokes, p => p.y);
+        if (bottom > screenHeight - PAGE_MARGIN.bottom) {
+            fail(`The diagram is too tall for the page: it needs ${Math.round(bottom - TEXT.firstBaseline)} px below the first line, the page has ${Math.round(screenHeight - PAGE_MARGIN.bottom - TEXT.firstBaseline)} px. Try "flowchart LR" or fewer nodes.`);
+        }
+
+        return {
+            text: lines.length ? '\u2028' + lines.join('\u2028') : '',
+            rows: lines.map((t, i) => ({ text: t, baseline: TEXT.firstBaseline + (i + 1) * P })),
+            strokes,
+            warnings
+        };
+    }
+
+    async function makePlan(source) {
+        await load();
+        const host = document.getElementById('mermaidMeasure');
+        host.textContent = '';
+        const { svg } = await window.mermaid.render('rmMermaid' + (++renderSeq), source);
+        host.innerHTML = svg;
+        const el = host.querySelector('svg');
+        const vb = el.viewBox.baseVal;
+        if (vb && vb.width > 0) {
+            el.setAttribute('width', vb.width);
+            el.setAttribute('height', vb.height);
+        }
+        el.style.maxWidth = 'none';
+        try {
+            return layout(extract(el));
+        } finally {
+            host.textContent = '';
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Finding the typed text on the screen
+    // ---------------------------------------------------------------------
+
+    async function grabScreen() {
+        const res = await fetch('/screenshot', { cache: 'no-store' });
+        if (!res.ok) throw new Error('screenshot: HTTP ' + res.status);
+        const bmp = await createImageBitmap(await res.blob());
+        const c = document.createElement('canvas');
+        c.width = bmp.width;
+        c.height = bmp.height;
+        const ctx = c.getContext('2d', { willReadFrequently: true });
+        ctx.drawImage(bmp, 0, 0);
+        const d = ctx.getImageData(0, 0, c.width, c.height).data;
+        const gray = new Uint8Array(c.width * c.height);
+        for (let i = 0; i < gray.length; i++) {
+            gray[i] = (d[4 * i] * 77 + d[4 * i + 1] * 150 + d[4 * i + 2] * 29) >> 8;
+        }
+        return { width: c.width, height: c.height, gray };
+    }
+
+    // locateText compares the screen before and after typing with the text
+    // the plan expects, and returns how far the text landed from where it was
+    // expected ({dx, dy, score}), or null when it was not found.
+    function locateText(before, after, rows) {
+        const W = after.width, H = after.height;
+        if (before.width !== W || before.height !== H) return null;
+        // Pixels that got darker: the new text (and the text cursor).
+        const ink = new Uint8Array(W * H);
+        for (let i = 0; i < ink.length; i++) ink[i] = before.gray[i] - after.gray[i] > 60 ? 1 : 0;
+        // The expected text.
+        const c = document.createElement('canvas');
+        c.width = W;
+        c.height = H;
+        const ctx = c.getContext('2d', { willReadFrequently: true });
+        ctx.font = `${TEXT.size}px "${TEXT.font}"`;
+        for (const r of rows) ctx.fillText(r.text, TEXT.left, r.baseline);
+        const alpha = ctx.getImageData(0, 0, W, H).data;
+        const tpl = [];
+        for (let i = 0; i < W * H; i++) if (alpha[4 * i + 3] > 128) tpl.push(i);
+        if (!tpl.length) return { dx: 0, dy: 0, score: 1 };
+
+        const score = (pts, grid, gw, gh, dx, dy) => {
+            let hit = 0;
+            for (const i of pts) {
+                const x = i % gw + dx, y = ((i / gw) | 0) + dy;
+                if (x >= 0 && y >= 0 && x < gw && y < gh && grid[y * gw + x]) hit++;
+            }
+            return hit / pts.length;
+        };
+        // Coarse search on 8x8 blocks: the text may land up to 160 px left or
+        // right (another text width) and lower down (text already on the page).
+        const S = 8, WS = Math.ceil(W / S), HS = Math.ceil(H / S);
+        const inkS = new Uint8Array(WS * HS);
+        for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) if (ink[y * W + x]) inkS[((y / S) | 0) * WS + ((x / S) | 0)] = 1;
+        const tplS = Array.from(new Set(tpl.map(i => ((((i / W) | 0) / S) | 0) * WS + (((i % W) / S) | 0))));
+        let best = { dx: 0, dy: 0, score: -1 };
+        for (let dy = -30; dy <= 225; dy++) {
+            for (let dx = -20; dx <= 20; dx++) {
+                const s = score(tplS, inkS, WS, HS, dx, dy);
+                if (s > best.score || (s === best.score && Math.abs(dy) + Math.abs(dx) < Math.abs(best.dy) + Math.abs(best.dx))) {
+                    best = { dx, dy, score: s };
+                }
+            }
+        }
+        // Fine search around it, with the ink grown by two pixels to forgive
+        // differences in antialiasing and rounding.
+        let grown = ink;
+        for (let pass = 0; pass < 2; pass++) {
+            const g = new Uint8Array(W * H);
+            for (let y = 1; y < H - 1; y++) {
+                for (let x = 1; x < W - 1; x++) {
+                    const i = y * W + x;
+                    g[i] = grown[i] | grown[i - 1] | grown[i + 1] | grown[i - W] | grown[i + W];
+                }
+            }
+            grown = g;
+        }
+        let fine = { dx: 0, dy: 0, score: -1 };
+        for (let dy = best.dy * S - S - 2; dy <= best.dy * S + S + 2; dy++) {
+            for (let dx = best.dx * S - S - 2; dx <= best.dx * S + S + 2; dx++) {
+                const s = score(tpl, grown, W, H, dx, dy);
+                if (s > fine.score) fine = { dx, dy, score: s };
+            }
+        }
+        return fine.score >= 0.6 ? fine : null;
+    }
