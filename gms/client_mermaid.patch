+                <button class="help-close" id="mermaidClose" aria-label="Close">&times;</button>
+                <h2 id="mermaidTitle">Mermaid diagram</h2>
+                <p class="mermaid-hint">Open an empty page in portrait and pick the fineliner on the tablet.
+                    Labels are typed with the tablet's text tool, boxes and arrows are drawn with the pen.</p>
+                <div class="mermaid-body">
+                    <textarea id="mermaidSource" spellcheck="false" aria-label="Mermaid source"></textarea>
+                    <div class="mermaid-preview" aria-label="Preview of the page"></div>
+                </div>
+                <ul class="mermaid-warnings"></ul>
+                <div class="mermaid-status" role="status"></div>
+                <div class="mermaid-actions">
+                    <button id="mermaidStop" class="mermaid-button">Stop</button>
+                    <button id="mermaidDraw" class="mermaid-button mermaid-primary">Draw on the tablet</button>
