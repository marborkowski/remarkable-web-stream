+    display: flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 0;
+    background: var(--bg-surface);
+    border-radius: var(--radius-md);
+}
+.mermaid-preview svg {
+    max-width: 100%;
+    max-height: 100%;
+}
+.mermaid-page {
+    fill: #ffffff;
+    stroke: var(--glass-border-hover);
+    stroke-width: 4;
+}
