+            ? strokes.flatMap(line => clip(line, { x0: vb.x, y0: vb.y, x1: vb.x + vb.width, y1: vb.y + vb.height }))
+            : strokes;
+        return { labels, strokes: visible, warnings: Array.from(warnings) };
+    }
