+        if (svg.querySelector('foreignObject')) {
+            warnings.add('Some parts of this diagram are HTML; they are left out.');
+        }
+        const strokes = [];
+        for (const el of svg.querySelectorAll('path, line, polyline, polygon, rect, circle, ellipse')) {
+            if (el.closest('defs, marker, clipPath, mask, pattern, symbol') || !el.getClientRects().length) continue;
+            const style = getComputedStyle(el);
+            if (style.visibility === 'hidden' || parseFloat(style.opacity) === 0) continue;
+            const drawn = outline(el, toRoot(el), style, strokes);
