+    // extract reads labels and strokes from a rendered diagram, in the
+    // coordinates of its root <svg> (pixels at the tablet's text size).
+    function extract(svg) {
+        measure(' ');
+        const metrics = measureCtx.measureText('Hg');
+        const ascent = metrics.fontBoundingBoxAscent / (metrics.fontBoundingBoxAscent + metrics.fontBoundingBoxDescent) || 0.787;
+        const rootInv = svg.getScreenCTM().inverse();
+        const toRoot = el => rootInv.multiply(el.getScreenCTM());
+        const warnings = new Set();
+        const labels = [];
+        for (const text of svg.querySelectorAll('text')) {
+            if (!text.getClientRects().length || text.closest('defs, marker')) continue;
+            for (const el of lineElements(text)) {
+                const content = el.textContent.replace(/\s+/g, ' ').trim();
+                if (!content || !el.getNumberOfChars()) continue;
+                const m = toRoot(el);
+                if (Math.abs(m.b) > 1e-3 || Math.abs(m.c) > 1e-3) {
+                    warnings.add('Rotated labels are left out: the tablet can only type horizontal text.');
