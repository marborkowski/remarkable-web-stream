+function applyAccess(state) {
+    if (typeof state.canDraw === 'boolean' && state.canDraw !== canDraw) {
+        canDraw = state.canDraw;
+        const draw = document.getElementById('drawToggle');
+        if (draw) draw.parentElement.style.display = canDraw ? '' : 'none';
+        if (!canDraw && drawMode) {
+            setDrawMode(false);
+        }
+    }
