+// ---------------------------------------------------------------------------
+// Remote pen: draw on the tablet with the mouse, a finger or a stylus.
+//
+// Pointer positions on the preview are converted back to the tablet's native
+// portrait coordinates (normalised 0..1), undoing the view rotation, and sent
+// over a WebSocket (/pen) to the rmshare proxy, which injects them as pen
+// events with a fixed pressure. xochitl draws them with the selected tool.
+// ---------------------------------------------------------------------------
+let drawMode = false;
+let penSocket = null;
+let penQueue = [];
+let penDown = false;
+
+function penConnect() {
+    if (penSocket && (penSocket.readyState === WebSocket.OPEN || penSocket.readyState === WebSocket.CONNECTING)) {
+        return;
+    }
+    const scheme = location.protocol === 'https:' ? 'wss:' : 'ws:';
+    penSocket = new WebSocket(`${scheme}//${location.host}/pen`);
+    penSocket.onopen = () => penFlush();
+    penSocket.onclose = () => {
+        penSocket = null;
+        if (drawMode) {
+            setTimeout(penConnect, 2000);
+        }
+    };
+}
+
+function penFlush() {
+    if (penQueue.length && penSocket && penSocket.readyState === WebSocket.OPEN) {
+        penSocket.send(penQueue.join('\n'));
+        penQueue = [];
+    }
+}
+
+// Display position -> native portrait coordinates (0..1). Mirrors the laser
+// mapping in worker_event_processing.js: in the rotated view (portrait=true)
+// native X runs top->bottom and native Y right->left; flip is a 180° turn.
+function penNativeCoords(e) {
+    const rect = visibleCanvas.getBoundingClientRect();
+    let u = (e.clientX - rect.left) / rect.width;
+    let v = (e.clientY - rect.top) / rect.height;
+    if (flip) {
+        u = 1 - u;
+        v = 1 - v;
+    }
+    return portrait ? [v, 1 - u] : [u, v];
+}
+
+function penSend(cmd, e) {
+    if (cmd === 'u') {
+        penQueue.push('u');
+    } else {
+        const [x, y] = penNativeCoords(e);
+        penQueue.push(`${cmd} ${x.toFixed(5)} ${y.toFixed(5)}`);
+    }
+}
+
+function onPenDown(e) {
+    if (!drawMode || e.button > 0) return;
+    e.preventDefault();
+    visibleCanvas.setPointerCapture(e.pointerId);
+    penDown = true;
+    penSend('d', e);
+    penFlush();
+}
+
+function onPenMove(e) {
+    if (!drawMode || !penDown) return;
+    e.preventDefault();
+    const events = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
+    for (const ce of (events.length ? events : [e])) {
+        penSend('m', ce);
+    }
+    penFlush();
+}
+
+function onPenUp(e) {
+    if (!drawMode || !penDown) return;
+    e.preventDefault();
+    penDown = false;
+    penSend('m', e);
+    penSend('u');
+    penFlush();
+}
+
+function setDrawMode(on) {
+    drawMode = on;
+    const btn = document.getElementById('drawToggle');
+    btn.classList.toggle('toggled', on);
+    btn.setAttribute('aria-pressed', on.toString());
+    visibleCanvas.classList.toggle('draw-mode', on);
+    if (on) {
+        penConnect();
+    } else {
+        if (penDown) {
+            penDown = false;
+            penQueue.push('u');
+            penFlush();
+        }
+        if (penSocket) {
+            penSocket.close();
+        }
+    }
+}
+
+visibleCanvas.addEventListener('pointerdown', onPenDown);
+visibleCanvas.addEventListener('pointermove', onPenMove);
+visibleCanvas.addEventListener('pointerup', onPenUp);
+visibleCanvas.addEventListener('pointercancel', onPenUp);
+visibleCanvas.addEventListener('lostpointercapture', onPenUp);
+
+document.getElementById('drawToggle').addEventListener('click', function () {
+    setDrawMode(!drawMode);
+    showMessage(drawMode ? 'Drawing on the tablet: on (uses the tool selected on the tablet)' : 'Drawing on the tablet: off', MessageDuration.QUICK);
+});
