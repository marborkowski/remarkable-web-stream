+// ---------------------------------------------------------------------------
+// Auto-rotate: follow the tablet's UI orientation.
+//
+// The rmshare proxy reads xochitl's log ("Setting new orientation Landscape")
+// and exposes it on /state, long-polled with ?wait=<version>, so a rotation on
+// the tablet reaches the browser within a moment. The framebuffer itself is
+// always native portrait; each device orientation maps onto the two view
+// primitives the client already has: `portrait` (a 90° turn, which the pen /
+// laser coordinate mapping also follows) and `flip` (a 180° CSS turn).
+// ---------------------------------------------------------------------------
+const ORIENTATION_VIEWS = {
+    Portrait:          { portrait: false, flip: false },
+    InvertedPortrait:  { portrait: false, flip: true },
+    Landscape:         { portrait: true,  flip: true },
+    InvertedLandscape: { portrait: true,  flip: false },
+};
+
+let autoRotate = true;
+let deviceOrientation = null;
+let deviceStateVersion = 0;
+
+function setAutoRotate(on) {
+    autoRotate = on;
+    const btn = document.getElementById('autoRotate');
+    btn.classList.toggle('toggled', on);
+    btn.setAttribute('aria-pressed', on.toString());
+    savePreference(STORAGE_KEYS.AUTO_ROTATE, on);
+    if (on) {
+        applyDeviceOrientation();
+    }
+}
+
+function applyDeviceOrientation() {
+    const view = ORIENTATION_VIEWS[deviceOrientation];
+    if (!view || (view.portrait === portrait && view.flip === flip)) {
+        return;
+    }
+    portrait = view.portrait;
+    flip = view.flip;
+    const rotateBtn = document.getElementById('rotate');
+    rotateBtn.classList.toggle('toggled', portrait);
+    rotateBtn.setAttribute('aria-pressed', portrait.toString());
+    if (typeof eventWorker !== 'undefined') {
+        eventWorker.postMessage({ type: 'portrait', portrait: portrait });
+    }
+    resizeVisibleCanvas();
+    redrawScene(portrait, 1);
 }
 
+async function pollDeviceState() {
+    for (;;) {
+        try {
+            const response = await fetch('/state?wait=' + deviceStateVersion, { cache: 'no-store' });
+            if (response.status === 404) {
+                return; // not served through the rmshare proxy: nothing to follow
+            }
+            if (!response.ok) {
+                throw new Error('HTTP ' + response.status);
+            }
+            const state = await response.json();
+            deviceStateVersion = state.version;
+            if (state.orientation && state.orientation !== deviceOrientation) {
+                const first = deviceOrientation === null;
+                deviceOrientation = state.orientation;
+                if (autoRotate) {
+                    applyDeviceOrientation();
+                    if (!first) {
+                        showMessage(`Tablet orientation: ${deviceOrientation}`, MessageDuration.QUICK);
+                    }
+                }
+            }
+        } catch (err) {
+            // network hiccup, expired session, proxy restart: retry calmly
+            await new Promise(resolve => setTimeout(resolve, 5000));
+        }
+    }
+}
+
+document.getElementById('autoRotate').addEventListener('click', function () {
+    setAutoRotate(!autoRotate);
+    showMessage(`Auto-rotate ${autoRotate ? 'on' : 'off'}`, MessageDuration.QUICK);
+});
+
+(function initAutoRotate() {
+    let saved = null;
+    try { saved = localStorage.getItem(STORAGE_KEYS.AUTO_ROTATE); } catch (e) { /* storage blocked */ }
+    autoRotate = saved === null ? true : saved === 'true';
+    const btn = document.getElementById('autoRotate');
+    btn.classList.toggle('toggled', autoRotate);
+    btn.setAttribute('aria-pressed', autoRotate.toString());
+    pollDeviceState();
+})();
