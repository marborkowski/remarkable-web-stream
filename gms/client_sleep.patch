+// Attempt to reconnect the stream. Never gives up: the tablet may be asleep
+// or offline for hours, and the page should recover on its own.
+function attemptStreamReconnect() {
+	isReconnecting = true;
+	reconnectAttempts = Math.min(reconnectAttempts + 1, MAX_RECONNECT_ATTEMPTS);
+	showSleepOverlay('Brak połączenia z tabletem');
+	if (reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
+		updateConnectionStatus(ConnectionState.DISCONNECTED);
+		hideReconnectBanner();
+	} else {
+		updateConnectionStatus(ConnectionState.RECONNECTING);
+		showReconnectBanner(reconnectAttempts, MAX_RECONNECT_ATTEMPTS);
+	}
+
+	const delay = getReconnectDelay();
+	console.log(`Reconnecting in ${delay/1000}s (attempt ${reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS})`);
+	scheduleStreamRestart(delay);
+}
