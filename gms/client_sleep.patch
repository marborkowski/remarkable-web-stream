+/* Overlay shown instead of the last frame while the tablet sleeps / is unreachable */
+.sleep-overlay {
+    position: absolute;
+    inset: 0;
+    z-index: calc(var(--z-canvas) + 1);
+    display: none;
+    align-items: center;
+    justify-content: center;
+    background: var(--bg-elevated);
+    font-family: var(--font-sans);
+    font-size: 1.4rem;
+    opacity: 0.85;
+}
+.sleep-overlay.visible {
+    display: flex;
