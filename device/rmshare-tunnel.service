[Unit]
Description=rmshare: tunnel (Tailscale Funnel / Cloudflare) -> proxy :8080
# The binaries live on the encrypted /home partition.
RequiresMountsFor=/home/root/rmshare
After=network-online.target rmshare-proxy.service
Wants=network-online.target rmshare-proxy.service

[Service]
Type=simple
ExecStart=/home/root/rmshare/run-tunnel.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rmshare-tunnel

[Install]
WantedBy=multi-user.target
