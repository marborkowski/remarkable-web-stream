[Unit]
Description=rmshare: password-protected proxy in front of goMarkableStream
# The binaries live on the encrypted /home partition.
RequiresMountsFor=/home/root/rmshare
After=rmshare-stream.service
Wants=rmshare-stream.service

[Service]
Type=simple
# PUBLISH_DOC=1: whenever the tunnel URL changes, save a PDF with the URL and a QR code
# to the tablet's library (restarts xochitl). Override in /home/root/rmshare/tunnel.env,
# which also provides RMSHARE_PASSWORD.
Environment=PUBLISH_DOC=1
EnvironmentFile=-/home/root/rmshare/tunnel.env
ExecStart=/home/root/rmshare/rmshare -listen :8080 -upstream http://127.0.0.1:2011 -urlfile /home/root/rmshare/tunnel-url.txt -doc=${PUBLISH_DOC}
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rmshare-proxy

[Install]
WantedBy=multi-user.target
