[Unit]
Description=rmshare: proxy z haslem przed goMarkableStream
After=rmshare-stream.service
Wants=rmshare-stream.service

[Service]
Type=simple
# PUBLISH_DOC=1: po kazdej zmianie adresu tunelu zapisuje PDF z adresem i QR
# w bibliotece tabletu (restartuje xochitl). Nadpisz w /home/root/rmshare/tunnel.env.
Environment=PUBLISH_DOC=1
EnvironmentFile=-/home/root/rmshare/tunnel.env
ExecStart=/home/root/rmshare/rmshare -listen :8080 -upstream http://127.0.0.1:2011 -urlfile /home/root/rmshare/tunnel-url.txt -doc=${PUBLISH_DOC}
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rmshare-proxy

[Install]
WantedBy=multi-user.target
